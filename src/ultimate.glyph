// D1 - MiniDrawn, 5/4
const p_d1: string = "XXOOOXXOX"

// D2 - MiniDrawn, 4/5
const p_d2: string = "OOXXXOOXO"

// L1 - MiniOpen with ONE empty cell (2); X@2 wins, O@2 draws
const p_l1: string = "XX.OOXXOO"

// SP_OPEN - cell 0 empty; X@0 leaves the board open
const p_sp_open: string = ".O.X....."

// SP_WIN - cell 0 empty; X@0 wins [0,1,2]
const p_sp_win: string = ".XXOO...."

// SP_DRAW - cell 0 empty; X@0 fills it with no line
const p_sp_draw: string = ".XOOXXXOO"

// DIAG - cell 4 empty; X@4 wins [0,4,8]
const p_diag: string = "XOO.....X"

// THREAT8 - X@8 wins [2,5,8]
const p_threat8: string = "..X.OX..."

// B6 - the AC-35 trap board, empties {0,2,6,8}
const p_b6: string = ".X.OXO.O."

// ONEX - parity filler
const p_onex: string = "X........"

// Synthetic: holds a line for BOTH marks (E-17 / TE-072)
const p_bothmini: string = "XXXOOO..."

// G-CHAIN5: (4,4) (4,0) (0,8) (8,2) (2,6)
const g_chain5_text: string = "U1|X|4440088226"

// G-20: twenty legal moves, no board closed
const g_20_text: string = "U1|X|0112233445566778800224466881133557700336"

// G-CLOSED: X owns board 4 after six moves; turn X, free move
const g_closed_text: string = "U1|X|400441144224"

// G-XWIN: move 17 closes board 8 AND completes meta line [0,4,8]
const g_xwin_text: string = "U1|X|0440088000144224466444388228855888"

fn grid(groups: Array<string>) -> string {
  return string.join(groups, "/")
}

fn fx(groups: Array<string>, f: Option<number>, t: Cell) -> UState {
  return state_from_text(grid(groups), f, t)
}

fn fx_new() -> UState {
  return new_game(X)
}

