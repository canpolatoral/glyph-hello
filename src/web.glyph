module web

import std/array
import std/fs
import std/http
import std/io
import std/option { Some, None }
import std/path
import std/process
import std/string
import xox { Board, Eval, Ongoing, Draw, Win }
import xox

// What the browser posts: the position, the square just clicked (-1 to ask
// the engine to open), whose mark that square is, and who the opponent is.
type MoveRequest = { board: string, square: number, turn: string, level: string }

// The authoritative reply. The server owns the rules; the page only draws.
type MoveResponse = {
  board: string,
  legal: bool,
  played: number,
  reply: number,
  turn: string,
  status: string,
  line: Array<number>,
  evals: Array<Eval>,
}

type ApiError = { error: string }

fn is_ongoing(b: Board) -> bool {
  return match xox.outcome(b) {
    Ongoing => true,
    Draw => false,
    Win(_w) => false,
  }
}

fn winning_line(b: Board) -> Array<number> {
  return match xox.outcome(b) {
    Win(w) => w.line,
    Draw => [],
    Ongoing => [],
  }
}

// Applies the human's move, then the engine's reply, and reports the result.
fn resolve(m: MoveRequest) -> MoveResponse {
  let start = xox.from_text(m.board)
  let turn = xox.cell_from(m.turn)
  let legal = m.square >= 0 && xox.is_free(start, m.square)
  let played = match legal {
    true => xox.place(start, m.square, turn),
    false => start,
  }
  let next = xox.other(turn)
  // A negative square is the page asking the engine to open. Any other
  // rejected move earns no reply, so a stale click cannot gift it a turn.
  let asked_to_open = m.square < 0
  let engine_plays = m.level != "human" && (legal || asked_to_open) && is_ongoing(played)
  let reply = match engine_plays {
    true => xox.choose_move(played, next, xox.level_from(m.level)),
    false => None,
  }
  let ended = match reply {
    Some(idx) => xox.place(played, idx, next),
    None => played,
  }
  let reply_square = match reply {
    Some(idx) => idx,
    None => -1,
  }
  // After an engine reply it is the human's move again; in two-player mode
  // the turn passes; an illegal click changes nothing.
  let passed = match legal {
    true => next,
    false => turn,
  }
  let after = match reply {
    Some(_idx) => turn,
    None => passed,
  }
  let evals = match is_ongoing(ended) {
    true => xox.evaluate(ended, after),
    false => [],
  }
  let played_square = match legal {
    true => m.square,
    false => -1,
  }
  let out: MoveResponse = {
    board: xox.to_text(ended),
    legal: legal,
    played: played_square,
    reply: reply_square,
    turn: xox.mark(after),
    status: xox.outcome_label(ended),
    line: winning_line(ended),
    evals: evals,
  }
  return out
}

fn move_route(req: http.Request) -> http.Response {
  return match MoveRequest.parse(req.body) {
    Ok(m) => http.json(200, resolve(m)),
    Err(_issues) => bad_request(),
  }
}

fn bad_request() -> http.Response {
  let body: ApiError = { error: "send board, square, turn and level" }
  return http.json(400, body)
}

// The page is three ordinary files under assets/ — no markup lives in Glyph.
// They are read per request, so editing the CSS or JS shows up on a refresh
// without restarting the server.
const asset_dir: string = "assets"

const html_type: string = "text/html; charset=utf-8"

const css_type: string = "text/css; charset=utf-8"

const js_type: string = "text/javascript; charset=utf-8"

const text_type: string = "text/plain; charset=utf-8"

const json_type: string = "application/json; charset=utf-8"

const svg_type: string = "image/svg+xml"

fn asset_path(name: string) -> string {
  return path.join([process.cwd(), asset_dir, name])
}

fn typed(status: number, body: string, mime: string) -> http.Response {
  let r: http.Response = { status: status, headers: { "content-type": mime }, body: body, url: "" }
  return r
}

fn serve_asset(name: string, mime: string) -> http.Response {
  return match fs.read_text(asset_path(name)) {
    Ok(text) => typed(200, text, mime),
    Err(e) => missing(name, e.message),
  }
}

// A missing static file is a 404, not the 500 that a missing index.html is:
// one is a bad URL, the other is a broken install.
fn read_static(rel: string, mime: string) -> http.Response {
  return match fs.read_text(asset_path(rel)) {
    Ok(text) => typed(200, text, mime),
    Err(_e) => typed(404, "Not found: ${rel}", text_type),
  }
}

fn extension_of(name: string) -> string {
  let parts = string.split(name, ".")
  let n = array.len(parts)
  return match n > 1 {
    true => parts[n - 1],
    false => "",
  }
}

// Text formats only: `fs.read_text` would corrupt a binary body, so an
// extension that is not listed here is a 404 rather than a mangled file.
fn mime_for(ext: string) -> Option<string> {
  return match ext {
    "html" => Some(html_type),
    "css" => Some(css_type),
    "js" => Some(js_type),
    "mjs" => Some(js_type),
    "json" => Some(json_type),
    "map" => Some(json_type),
    "svg" => Some(svg_type),
    else => None,
  }
}

// Everything under assets/ is servable, including the generated engine/ tree,
// so the client can add a file without the server learning its name.
fn static_route(route: string) -> http.Response {
  let rel = string.slice(route, 1)
  let escapes = string.contains(rel, "..")
  return match escapes {
    true => typed(403, "Refused: ${rel}", text_type),
    false => by_extension(rel),
  }
}

fn by_extension(rel: string) -> http.Response {
  return match mime_for(extension_of(rel)) {
    Some(mime) => read_static(rel, mime),
    None => typed(404, "Not found: ${rel}", text_type),
  }
}

fn missing(name: string, why: string) -> http.Response {
  io.eprintln("  Could not read ${asset_dir}/${name}: ${why}")
  return typed(500, "Missing ${asset_dir}/${name}", text_type)
}

fn handle(req: http.Request) -> Result<http.Response, string> {
  return match http.path(req) {
    "/" => Ok(serve_asset("index.html", html_type)),
    "/api/move" => Ok(move_route(req)),
    else => Ok(static_route(http.path(req))),
  }
}

pub async fn start(port: number) -> number {
  let url = "http://localhost:${number.to_string(port)}"
  io.println("")
  match fs.exists(asset_path("index.html")) {
    true => io.println("  XOX is running at ${url}"),
    false => warn_assets(),
  }
  io.println("  Press ctrl-c to stop.")
  io.println("")
  let served = await http.serve(port, handle)
  return match served {
    Ok(_v) => 0,
    Err(e) => report(e),
  }
}

// The assets are found relative to the working directory, so say so plainly
// rather than serving 500s that look like a code problem.
fn warn_assets() -> void {
  io.eprintln("  No ${asset_dir}/index.html under ${process.cwd()}")
  io.eprintln("  Start the server from the project root.")
}

fn report(message: string) -> number {
  io.eprintln("  Could not start the server: ${message}")
  return 1
}
